/* App-wide style overrides. Loaded by gui.theme.load_qss() and applied to the
 * MainWindow so the rules cascade into FluentWindow's painted children.
 *
 * Token placeholders ({$SIDEBAR}, {$ACCENT}, ...) are filled at load time
 * by string.Template.substitute() on the active Tokens dataclass.
 *
 * RULES:
 *   - 这个文件只放无法靠 qfluentwidgets 组件 API 解决的样式
 *   - 文字字号/前景色 → 用 BodyLabel/CaptionLabel/SubtitleLabel/...，不要在这里写
 *   - 不要把任何颜色字面量写进 widget 代码：所有颜色一律来自 tokens
 */

/* ============================================================
 * 1. 顶层容器（FluentWindow / 导航 / 标题栏）
 * ============================================================ */

FluentWindow {
    background-color: $SIDEBAR;
}

/* 标题栏 — 与下方内容区之间的 1px 分界线（参考 Claude / VS Code） */
FluentTitleBar {
    border-bottom: 1px solid $BORDER;
}

/* Brand chip (20×20 clay square w/ italic serif D) — matches design §1 */
QLabel#brandChip {
    background-color: $ACCENT;
    color: white;
    border-radius: 5px;
    font-family: "Georgia", "Songti SC", serif;
    font-style: italic;
    font-weight: 600;
    font-size: 13px;
}
BodyLabel#brandName {
    color: $TEXT;
    font-family: "Georgia", "Songti SC", "Noto Serif SC", serif;
    font-size: 14px;
    font-weight: 500;
}
QFrame#crumbsBox {
    background-color: transparent;
}
CaptionLabel#crumbMuted {
    color: $TEXT_2;
    font-family: "JetBrains Mono", "Consolas", "SF Mono", monospace;
    font-size: 12px;
}
CaptionLabel#crumbActive {
    color: $TEXT;
    font-family: "JetBrains Mono", "Consolas", "SF Mono", monospace;
    font-size: 12px;
    font-weight: 500;
}
CaptionLabel#crumbSep {
    color: $TEXT_3;
    font-family: "JetBrains Mono", "Consolas", "SF Mono", monospace;
    font-size: 12px;
}

/* 标题栏里的数据集 chip：圆角胶囊，柔和背景 */
QWidget#datasetChip {
    background-color: $HOVER;
    border: 1px solid $BORDER;
    border-radius: 14px;
    min-height: 28px;
    max-height: 28px;
}
QLabel#datasetChipName { color: $TEXT; }
QLabel#datasetChipPath { color: $TEXT_3; }

#stackedWidget, #stackedWidget > QWidget {
    background-color: $CONTENT;
}

QWidget#overviewView, QWidget#qualityView, QWidget#exportView,
QWidget#pipelineView, QWidget#datasetWelcome,
QStackedWidget#browserStack {
    background-color: $CONTENT;
}
/* browser + detail views use the ivory canvas so cards (thumbnails,
 * distribution chart) float above it — matches Claude-web layering. */
QWidget#browserView, QWidget#detailView, QWidget#datasetBrowserView {
    background-color: $SIDEBAR;
}

NavigationInterface, NavigationInterface > QWidget {
    background-color: $SIDEBAR;
    border-right: 1px solid $BORDER;
}

TitleBar, TitleBar > QWidget {
    background-color: $SIDEBAR;
}

/* ============================================================
 * 2. 通用卡片
 * ============================================================ */

QFrame#statCard, QFrame#chartFrame {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}

QLabel#hintWarn {
    color: $WARNING;
}

QFrame#warningsFrame {
    background-color: $CONTENT;
    border: 1px solid $WARNING;
    border-radius: ${RADIUS_LG}px;
}
QLabel#warningsTitle {
    color: $TEXT_2;
    font-weight: bold;
}

/* ============================================================
 * 3. 按钮族
 * ============================================================ */

/* Filter chip segmented group — chips sit inside a single rail rather than
 * each carrying its own border/bg. The active chip promotes to the panel
 * color with a subtle shadow — single strong signal, quiet default. */
QFrame#filterChipGroup {
    background-color: $SURFACE_DIM;
    border-radius: ${RADIUS}px;
}
QPushButton#filterChip {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: ${RADIUS}px;
    padding: 4px 12px;
    color: $TEXT_2;
}
QPushButton#filterChip:hover {
    color: $TEXT;
}
QPushButton#filterChip:checked {
    background-color: $CONTENT;
    border-color: $BORDER;
    color: $TEXT;
    font-weight: 500;
}
QPushButton#filterChip:disabled {
    color: $TEXT_3;
}

QPushButton#ghostButton {
    background-color: transparent;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
    padding: 5px 14px;
    color: $TEXT_2;
}
QPushButton#ghostButton:hover {
    background-color: $HOVER;
    color: $ACCENT;
    border-color: $ACCENT;
}

/* ============================================================
 * 4. Browser 左侧类别栏
 * ============================================================ */

QFrame#categorySidebar {
    background-color: $SIDEBAR;
    border-right: 1px solid $BORDER;
}

/* ToolSidebar — left-hand vertical tool panel (replaces old top toolbar) */
QFrame#toolSidebar {
    background-color: $SIDEBAR;
    border-right: 1px solid $BORDER;
}
/* Section header: uppercase (done in Python), tracked, muted — matches the
 * design handoff's "ANALYZE / 处理" style. */
CaptionLabel#toolSidebarSection {
    color: $TEXT_3;
    padding: ${GAP_LG}px ${GAP}px ${GAP_XS}px ${GAP}px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}
/* Tool rows are custom QFrame widgets (QLabel icon + QLabel text inside) —
 * the old QPushButton version collided icon + text on long CN labels like
 * "格式转换" / "AI 预标注". Splitting icon/text into dedicated slots via
 * HBoxLayout keeps them from overlapping regardless of window width. */
QFrame#toolSidebarButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: ${RADIUS}px;
}
QLabel#toolSidebarText {
    color: $TEXT_2;
    font-size: 13px;
}
QFrame#toolSidebarButton:hover {
    background-color: $HOVER;
    border-color: $BORDER;
}
QFrame#toolSidebarButton:hover QLabel#toolSidebarText {
    color: $TEXT;
}
/* Featured: elevated white panel w/ subtle border (marquee — e.g. 导出). */
QFrame#toolSidebarButton[toolKind="featured"] {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
}
QFrame#toolSidebarButton[toolKind="featured"]:hover {
    border: 1px solid $HOVER_STRONG;
}
QFrame#toolSidebarButton[toolKind="featured"] QLabel#toolSidebarText {
    color: $TEXT;
    font-weight: 500;
}
/* AI row — accent-soft hover, accent text (differentiated capability). */
QFrame#toolSidebarButton[toolKind="ai"]:hover {
    background-color: $ACCENT_SOFT;
    border-color: $ACCENT_SOFT;
}
QFrame#toolSidebarButton[toolKind="ai"]:hover QLabel#toolSidebarText {
    color: $ACCENT;
}
/* Disabled state (cascaded via btnDisabled property). */
QFrame#toolSidebarButton[btnDisabled="true"] {
    background-color: transparent;
}
QFrame#toolSidebarButton[btnDisabled="true"] QLabel#toolSidebarText {
    color: $TEXT_3;
}

QLabel#sectionHeader {
    color: $TEXT_2;
    border-bottom: 1px solid $BORDER;
    padding-left: 14px;
}

QListWidget#categoryTree {
    background-color: transparent;
    border: none;
    padding: 4px;
    outline: 0;
}
QListWidget#categoryTree::item {
    padding: 0;
    margin: 0;
    color: $TEXT;
}
QListWidget#categoryTree::item:hover {
    background-color: $HOVER;
}
/* selection painted by delegate */
QListWidget#categoryTree::item:selected {
    background-color: transparent;
    color: $TEXT;
}

/* ============================================================
 * 4d. Catalog panel (right-hand 340px column)
 * ============================================================ */

QFrame#catalogPanel {
    background-color: $SIDEBAR;
    border-left: 1px solid $BORDER;
}
BodyLabel#catalogTitle {
    color: $TEXT;
    font-family: "Georgia", "Songti SC", "Noto Serif SC", serif;
    font-size: 16px;
    font-weight: 500;
}
CaptionLabel#catalogSubtitle {
    color: $TEXT_3;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}
QPushButton#catalogTab {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: ${RADIUS}px;
    padding: 3px 10px;
    color: $TEXT_2;
    font-size: 11px;
}
QPushButton#catalogTab:hover {
    color: $TEXT;
}
QPushButton#catalogTab:checked {
    background-color: $HOVER_STRONG;
    color: $TEXT;
    font-weight: 500;
}

/* ============================================================
 * 4c. Distribution chart card (nested inside Catalog panel)
 * ============================================================ */

QFrame#distributionChart {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
    margin: ${GAP_LG}px ${GAP}px ${GAP}px ${GAP}px;
}
CaptionLabel#distributionHead {
    color: $TEXT_3;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}
CaptionLabel#distributionRatio {
    color: $TEXT_2;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 11px;
}
CaptionLabel#distributionRatio[warn="true"] {
    color: $WARNING;
}
CaptionLabel#distributionFoot {
    color: $TEXT_3;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 10px;
}
BodyLabel#distributionCaption {
    color: $TEXT_2;
    font-size: 11px;
}

/* ============================================================
 * 4b. Dataset bar (Claude-web redesign — serif title + stat strip)
 * ============================================================ */

QFrame#datasetBar {
    background-color: $SIDEBAR;
    border-bottom: 1px solid $BORDER;
}
QLabel#datasetName {
    color: $TEXT;
    font-family: "Georgia", "Songti SC", "Noto Serif SC", serif;
    font-size: 17px;
    font-weight: 500;
}
QLabel#datasetPath {
    color: $TEXT_3;
    font-family: "JetBrains Mono", "Consolas", "SF Mono", monospace;
    font-size: 11px;
}
QLabel#statKey {
    color: $TEXT_3;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}
QLabel#statValue {
    color: $TEXT;
    font-family: "JetBrains Mono", "Consolas", "SF Mono", monospace;
    font-size: 15px;
    font-weight: 500;
}
QLabel#statValueWarn {
    color: $WARNING;
    font-family: "JetBrains Mono", "Consolas", "SF Mono", monospace;
    font-size: 15px;
    font-weight: 500;
}
QWidget#statCell {
    border-left: 1px solid $BORDER;
}
QFrame#statStrip > QWidget#statCell:first-child {
    border-left: none;
}

/* ============================================================
 * 5. Detail 视图
 * ============================================================ */

QFrame#detailTopBar {
    background-color: $CONTENT;
    border-bottom: 1px solid $BORDER;
}

QFrame#detailSidebar {
    background-color: $SIDEBAR;
    border-left: 1px solid $BORDER;
}

QListWidget#shapeList {
    background-color: transparent;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
    outline: 0;
}
QListWidget#shapeList::item {
    padding: 6px 10px;
    color: $TEXT;
}
QListWidget#shapeList::item:hover {
    background-color: $HOVER_STRONG;
}

/* ============================================================
 * 6. 缩略图网格
 * ============================================================ */

QListWidget#thumbnailGrid {
    background-color: $SIDEBAR;  /* ivory canvas, cards float above it */
    border: none;
    padding: 16px;
}
QListWidget#thumbnailGrid::item {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
}
QListWidget#thumbnailGrid::item:selected {
    background: transparent;
}

QFrame#thumbCard {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
QFrame#thumbCard:hover {
    border: 1px solid $HOVER_STRONG;
}
QFrame#thumbCard[selected="true"] {
    border: 2px solid $ACCENT;
}

QLabel#thumbImage {
    background-color: $SURFACE_DIM;
    color: $TEXT_3;
}

QWidget#thumbMeta {
    background-color: $CONTENT;
    border-top: 1px solid $BORDER;
}

QLabel#thumbBadge {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: 10px;
    padding: 0 8px;
    color: $TEXT_2;
}
QLabel#thumbBadge[state="labeled"] {
    color: $SUCCESS;
}
QLabel#thumbBadge[state="unlabeled"] {
    color: $WARNING;
}

/* ============================================================
 * 7. 欢迎页
 * ============================================================ */

QWidget#welcomeView {
    background-color: $CONTENT;
}

QLabel#welcomeTitle {
    color: $ACCENT;
}

QListWidget#projectList {
    background-color: $CONTENT;
    border: none;
    padding: 8px;
    outline: 0;
}
QListWidget#projectList::item {
    border: none;
    background: transparent;
    padding: 0;
    margin: 2px 0;
}

/* ============================================================
 * 8. 导出格式卡片
 * ============================================================ */

QFrame#formatCard {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
QFrame#formatCard:hover {
    background-color: $HOVER;
    border-color: $HOVER_STRONG;
}
QFrame#formatCard[selected="true"] {
    background-color: $ACCENT_SOFT;
    border: 2px solid $ACCENT;
}
QLabel#formatCardName[selected="true"] {
    color: $ACCENT;
}

/* ============================================================
 * 9. 预览面板
 * ============================================================ */

QFrame#previewSlot {
    background-color: $SURFACE_DIM;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}

/* ============================================================
 * 10. 占位视图
 * ============================================================ */

QLabel#placeholderStatus {
    color: $TEXT_2;
}

/* ============================================================
 * 11. 就绪检查条
 * ============================================================ */

QLabel#readinessOk,
QLabel#readinessGap {
    padding: 6px 14px;
    min-height: 20px;
    border-radius: 12px;
    background: $SURFACE_DIM;
}
QLabel#readinessOk {
    color: $SUCCESS;
}
QLabel#readinessGap {
    color: $WARNING;
    font-weight: 600;
}

/* ============================================================
 * 11b. Settings popup (floating Tweaks panel per design)
 * ============================================================ */

QFrame#settingsPopup {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
/* Settings popup — Claude-style menu list. */
BodyLabel#tweakHead {
    color: $TEXT_3;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding-left: 4px;
}
QLabel#tweakClose {
    color: $TEXT_3;
    font-size: 11px;
    border-radius: 4px;
}
QLabel#tweakClose:hover {
    color: $TEXT;
    background-color: $HOVER;
}
QFrame#tweakDivider {
    background-color: $BORDER;
    margin: 4px 8px;
}
QFrame#tweakRow {
    background-color: transparent;
    border-radius: ${RADIUS}px;
}
QFrame#tweakRow:hover {
    background-color: $HOVER;
}
QLabel#tweakIcon {
    color: $TEXT_2;
    background-color: transparent;
}
BodyLabel#tweakKey {
    color: $TEXT;
    font-size: 13px;
    background-color: transparent;
}
/* Inline segmented buttons — active state gets soft tan bg (design's
 * --bg-active ≈ rgba(60,40,20,0.07)). */
QPushButton#tweakSeg {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: ${RADIUS}px;
    padding: 3px 9px;
    color: $TEXT_3;
    font-size: 11px;
    min-width: 22px;
}
QPushButton#tweakSeg:hover {
    color: $TEXT;
}
QPushButton#tweakSeg:checked {
    background-color: $HOVER_STRONG;
    color: $TEXT;
}
/* ============================================================
 * 12. 节点编辑器工具箱 / 缩放按钮
 * ============================================================ */

QFrame#toolboxPanel {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
QFrame#toolboxItem:hover {
    background-color: $HOVER;
    border-radius: ${RADIUS}px;
}
QLabel#toolboxSection {
    color: $TEXT_3;
    padding: 4px 8px 2px 8px;
    font-weight: bold;
}
QLabel#toolboxTitle {
    font-weight: bold;
    color: $TEXT_2;
}
QFrame#zoomOverlay {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}

/* 标题栏方案名输入框 */
LineEdit#taskNameEdit {
    border: none;
    background: transparent;
    color: $TEXT;
    font-weight: bold;
    padding: 2px 4px;
}
LineEdit#taskNameEdit:focus {
    border: 1px solid $BORDER;
    border-radius: 4px;
    background: $CONTENT;
}

/* 节点检查器面板 */
QFrame#nodeInspector {
    background-color: $SIDEBAR;
    border-left: 1px solid $BORDER;
}
QFrame#inspectorHeader {
    border-bottom: 1px solid $BORDER;
}
QLabel#inspectorDesc {
    color: $TEXT_2;
}
QLabel#inspectorHint {
    color: $TEXT_3;
    font-size: 11px;
    padding: 2px 0;
}
QLabel#inspectorSectionTitle {
    color: $TEXT_3;
    font-weight: bold;
    padding: 4px 0 2px 0;
}
QFrame#inspectorSep {
    background-color: $BORDER;
}
QLabel#inspectorPortInfo {
    color: $ACCENT;
    padding: 2px 0;
}
QTreeWidget#inspectorDirTree {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
    padding: 4px;
    font-size: 12px;
}
QTreeWidget#inspectorDirTree::item {
    padding: 2px 0;
}

/* App-wide style overrides. Loaded by gui.theme.load_qss() and applied to the
 * MainWindow so the rules cascade into FluentWindow's painted children.
 *
 * Token placeholders ({$SIDEBAR}, {$ACCENT}, ...) are filled at load time
 * by string.Template.substitute() on the active Tokens dataclass.
 *
 * RULES:
 *   - 这个文件只放无法靠 qfluentwidgets 组件 API 解决的样式
 *   - 文字字号/前景色 → 用 BodyLabel/CaptionLabel/SubtitleLabel/...，不要在这里写
 *   - 不要把任何颜色字面量写进 widget 代码：所有颜色一律来自 tokens
 */

/* ============================================================
 * 1. 顶层容器（FluentWindow / 导航 / 标题栏）
 * ============================================================ */

FluentWindow {
    background-color: $SIDEBAR;
}

/* 标题栏 — 与下方内容区之间的 1px 分界线（参考 Claude / VS Code） */
FluentTitleBar {
    border-bottom: 1px solid $BORDER;
}

/* Brand chip (20×20 clay square w/ italic serif D) — matches design §1 */
QLabel#brandChip {
    background-color: $ACCENT;
    color: $ON_ACCENT;
    border-radius: 5px;
    font-family: "Georgia", "Songti SC", serif;
    font-style: italic;
    font-weight: 600;
    font-size: 13px;
}
BodyLabel#brandName {
    color: $TEXT;
    font-family: "Georgia", "Songti SC", "Noto Serif SC", serif;
    font-size: 14px;
    font-weight: 500;
}
QFrame#crumbsBox {
    background-color: transparent;
}
CaptionLabel#crumbMuted {
    color: $TEXT_2;
    font-size: 12px;
}
CaptionLabel#crumbActive {
    color: $TEXT;
    font-size: 12px;
    font-weight: 500;
}
CaptionLabel#crumbSep {
    color: $TEXT_3;
    font-size: 12px;
}

/* 标题栏里的数据集 chip：圆角胶囊，柔和背景 */
QWidget#datasetChip {
    background-color: $HOVER;
    border: 1px solid $BORDER;
    border-radius: 14px;
    min-height: 28px;
    max-height: 28px;
}
QLabel#datasetChipName { color: $TEXT; }
QLabel#datasetChipPath { color: $TEXT_3; }

#stackedWidget, #stackedWidget > QWidget {
    background-color: $CONTENT;
}

QWidget#overviewView, QWidget#qualityView, QWidget#exportView,
QWidget#pipelineView,
QStackedWidget#browserStack {
    background-color: $CONTENT;
}
/* Welcome / launchpad — uses the warm ivory canvas so project cards
 * float above it (the brand block sits flush to the canvas). */
QWidget#datasetWelcome {
    background-color: $SIDEBAR;
}
/* ── Overview console (项目概览) ── */
SubtitleLabel#overviewProjectName {
    color: $TEXT;
}
CaptionLabel#overviewProjectSub {
    color: $TEXT_2;
}
StrongBodyLabel#overviewStatValue {
    color: $TEXT;
    font-size: 20px;
    font-weight: 600;
}
StrongBodyLabel#overviewStatValue[warn="true"] {
    color: $WARNING;
}
CaptionLabel#overviewStatLabel {
    color: $TEXT_3;
    font-size: 11px;
}
QFrame#overviewClassRow {
    background-color: transparent;
    border-bottom: 1px solid $BORDER;
}
CaptionLabel#overviewLabelOk { color: $SUCCESS; }
CaptionLabel#overviewLabelPartial { color: $WARNING; }
CaptionLabel#overviewLabelNone { color: $TEXT_3; }
CaptionLabel#overviewNavLabel {
    color: $TEXT_3;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
}
QLabel#overviewImagePreview {
    background-color: $SURFACE_DIM;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}
QPlainTextEdit#overviewAnnotationCode {
    font-family: "Cascadia Mono", "Consolas", "SF Mono", monospace;
    font-size: 13px;
    background-color: $SIDEBAR;
    color: $TEXT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
    padding: 10px;
    selection-background-color: $ACCENT_SOFT;
}

TitleLabel#welcomeBrand {
    color: $TEXT;
    font-family: "Georgia", "Songti SC", "Noto Serif SC", serif;
}
CaptionLabel#welcomeTagline {
    color: $TEXT_2;
    font-size: 13px;
}
SubtitleLabel#welcomeSectionTitle {
    color: $TEXT_2;
    font-size: 14px;
}
CaptionLabel#welcomeSectionSubtitle {
    color: $TEXT_3;
    font-size: 12px;
}
CaptionLabel#welcomeEmptyHint {
    color: $TEXT_3;
}

/* Three top entry cards (新建项目 / 打开项目 / 打开普通数据集) — large
 * tile-style entry points. Primary card promotes ACCENT_SOFT to set
 * apart "new project" from the other two. */
QFrame#welcomeEntryCard {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
QFrame#welcomeEntryCard:hover {
    border-color: $ACCENT;
}
QFrame#welcomeEntryCard[primary="true"] {
    background-color: $ACCENT_SOFT;
    border-color: $ACCENT;
}
StrongBodyLabel#welcomeEntryTitle {
    color: $TEXT;
    font-size: 15px;
}
QFrame#welcomeEntryCard[primary="true"] StrongBodyLabel#welcomeEntryTitle {
    color: $ACCENT;
}
CaptionLabel#welcomeEntryBody {
    color: $TEXT_3;
}
QFrame#welcomeEntryCard[primary="true"] CaptionLabel#welcomeEntryBody {
    color: $TEXT_2;
}

/* Project cards in the welcome list */
QFrame#projectCard {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
QFrame#projectCard:hover {
    border-color: $ACCENT_SOFT;
}
QFrame#projectCard[missing="true"] {
    background-color: $SURFACE_DIM;
    border-color: $BORDER;
}
StrongBodyLabel#projectCardName {
    color: $TEXT;
    font-size: 15px;
}
CaptionLabel#projectCardTag {
    background-color: $BADGE_GHOST_BG;
    color: $TEXT_2;
    border-radius: 6px;
    padding: 1px 8px;
    font-size: 11px;
}
CaptionLabel#projectCardMeta {
    color: $TEXT_3;
    font-size: 12px;
}
StrongBodyLabel#projectCardStatValue {
    color: $TEXT;
    font-size: 18px;
    font-weight: 600;
}
StrongBodyLabel#projectCardStatValue[warn="true"] {
    color: $WARNING;
}
CaptionLabel#projectCardStatKey {
    color: $TEXT_3;
    font-size: 11px;
}
PushButton#projectCardCTA {
    background-color: $ACCENT_SOFT;
    border: none;
    border-radius: ${RADIUS}px;
    color: $ACCENT;
    padding: 4px 14px;
    font-weight: 500;
}
PushButton#projectCardCTA:hover {
    background-color: $ACCENT;
    color: $ON_ACCENT;
}
/* browser + detail views use the ivory canvas so cards (thumbnails,
 * distribution chart) float above it — matches Claude-web layering. */
QWidget#browserView, QWidget#detailView, QWidget#datasetBrowserView {
    background-color: $SIDEBAR;
}

NavigationInterface, NavigationInterface > QWidget {
    background-color: $SIDEBAR;
    border-right: 1px solid $BORDER;
}

TitleBar, TitleBar > QWidget {
    background-color: $SIDEBAR;
}

/* ============================================================
 * 2. 通用卡片
 * ============================================================ */

QFrame#statCard, QFrame#chartFrame {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}

/* Task card — used by 导出 task tiles + future review/manage
 * pages.  Same visual base as #chartFrame but objectName-distinct so
 * task-specific badges / dividers can hang off it. */
QFrame#taskCard {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
StrongBodyLabel#taskCardTitle {
    color: $TEXT;
    font-size: 14px;
}
CaptionLabel#taskCardKey {
    color: $TEXT_3;
    font-size: 12px;
}
CaptionLabel#taskCardValue {
    color: $TEXT;
    font-size: 12px;
}
CaptionLabel#taskCardHint {
    color: $TEXT_3;
    font-size: 11px;
}
/* Scope badge — single visual vocabulary for "what does this act on".
 * Three variants cover every action surface: informational scope
 * (neutral grey), read-only export (warm tan), project-mutating
 * (amber + bold).  ScopeBadge widget at gui/widgets/scope_badge.py
 * is the only place that should set these object names. */
CaptionLabel#scopeBadge {
    border-radius: 4px;
    padding: 1px 8px;
    font-size: 11px;
}
CaptionLabel#scopeBadge[scope="neutral"] {
    background-color: $SURFACE_DIM;
    color: $TEXT_2;
}
CaptionLabel#scopeBadge[scope="readonly"] {
    background-color: $ACCENT_SOFT;
    color: $ACCENT;
}
CaptionLabel#scopeBadge[scope="writes"] {
    background-color: $WARNING_SOFT;
    color: $WARNING;
    font-weight: 500;
}

/* 审核修复 (ReviewHub) — top toolbar + summary + queue card + detail
 * pane.  Toolbar sits flush to the page top with a hairline separator
 * to the summary; summary itself sits flush to the queue body. */
QFrame#reviewToolbar {
    background-color: $CONTENT;
    border-bottom: 1px solid $BORDER;
}
QFrame#reviewSummary {
    background-color: $SIDEBAR;
    border-bottom: 1px solid $BORDER;
}
StrongBodyLabel#reviewSummaryValue {
    color: $TEXT;
    font-size: 22px;
    font-weight: 600;
}
StrongBodyLabel#reviewSummaryValue[warn="true"] {
    color: $WARNING;
}
CaptionLabel#reviewSummaryKey {
    color: $TEXT_3;
    font-size: 11px;
}
QFrame#reviewQueueCard {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
QListWidget#reviewQueueList {
    background-color: $CONTENT;
    border: none;
    outline: 0;
    padding: 4px;
}
QListWidget#reviewQueueList::item {
    color: $TEXT;
    padding: 8px 10px;
    border-radius: ${RADIUS}px;
}
QListWidget#reviewQueueList::item:hover {
    background-color: $HOVER;
}
QListWidget#reviewQueueList::item:selected {
    background-color: $ACCENT_SOFT;
    color: $ACCENT;
}
QFrame#reviewDetail {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
TitleLabel#reviewDetailTitle {
    color: $TEXT;
    font-size: 16px;
}
QLabel#reviewDetailPreview {
    background-color: $SURFACE_DIM;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}
CaptionLabel#reviewDetailMetaKey {
    color: $TEXT_3;
}
BodyLabel#reviewDetailMetaValue {
    color: $TEXT;
}
CaptionLabel#reviewDetailEmpty {
    color: $TEXT_3;
}

/* ProjectManageHub — class management rows + preset hint */
QFrame#manageClassRow {
    background-color: transparent;
    border-radius: ${RADIUS}px;
}
QFrame#manageClassRow:hover {
    background-color: $HOVER;
}
BodyLabel#manageClassRowName {
    color: $TEXT;
}
CaptionLabel#manageClassRowCount {
    color: $TEXT_3;
}
CaptionLabel#manageClassesEmpty {
    color: $TEXT_3;
    padding: 16px 0;
}
CaptionLabel#manageClassesCount {
    color: $TEXT_3;
}
CaptionLabel#manageCapsHint {
    color: $TEXT_3;
}
QScrollArea#manageClassesScroll {
    background-color: transparent;
    border: none;
}

/* DeliveryHub LLM-data zone — full P1.7 card with status + format
 * radio + help link + planned footer.  Inherits #taskCard surface
 * (set on the host frame) so its outline matches the rest of the
 * delivery cards. */
StrongBodyLabel#llmEmptyTitle {
    color: $TEXT;
    font-size: 14px;
}
CaptionLabel#llmEmptyBody {
    color: $TEXT_3;
}
CaptionLabel#llmStatusHeader {
    color: $TEXT_3;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}
CaptionLabel#llmStatusKey {
    color: $TEXT_3;
}
BodyLabel#llmStatusValue {
    color: $TEXT;
}
RadioButton#llmFormatRadio {
    color: $TEXT;
}
CaptionLabel#llmFormatDesc {
    color: $TEXT_3;
}
HyperlinkButton#llmHelpLink {
    color: $ACCENT;
    background: transparent;
    border: none;
}
CaptionLabel#llmPlannedFooter {
    color: $TEXT_3;
    font-size: 11px;
}

/* LLM format reference dialog — table cells + warning */
CaptionLabel#llmHelpIntro {
    color: $TEXT_2;
}
StrongBodyLabel#llmHelpHeader {
    color: $TEXT_3;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}
StrongBodyLabel#llmHelpFormatName {
    color: $ACCENT;
    font-size: 13px;
}
BodyLabel#llmHelpCell {
    color: $TEXT;
    font-size: 12px;
}
CaptionLabel#llmHelpWarn {
    background-color: $WARNING_SOFT;
    color: $WARNING;
    border-radius: ${RADIUS}px;
    padding: 8px 12px;
    font-weight: 500;
}

/* BrowserView footer + empty-state copy */
CaptionLabel#browserFooterCount {
    color: $TEXT_2;
}
CaptionLabel#browserFooterLoading {
    color: $ACCENT;
    font-weight: 500;
}
CaptionLabel#browserEmptyHint {
    color: $TEXT_3;
    font-size: 13px;
}

QLabel#hintWarn {
    color: $WARNING;
}

QFrame#warningsFrame {
    background-color: $CONTENT;
    border: 1px solid $WARNING;
    border-radius: ${RADIUS_LG}px;
}
QLabel#warningsTitle {
    color: $TEXT_2;
    font-weight: bold;
}

/* ============================================================
 * 3. 按钮族
 * ============================================================ */

/* Filter chip segmented group — chips sit inside a single rail rather than
 * each carrying its own border/bg. The active chip promotes to the panel
 * color with a subtle shadow — single strong signal, quiet default. */
QFrame#filterChipGroup {
    background-color: $SURFACE_DIM;
    border-radius: ${RADIUS}px;
}
QPushButton#filterChip {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: ${RADIUS}px;
    padding: 4px 12px;
    color: $TEXT_2;
}
QPushButton#filterChip:hover {
    color: $TEXT;
}
QPushButton#filterChip:checked {
    background-color: $CONTENT;
    border-color: $BORDER;
    color: $TEXT;
    font-weight: 500;
}
QPushButton#filterChip:disabled {
    color: $TEXT_3;
}

/* Workspace sidebar — slim vertical stage nav (5 list rows, 168px).
 * SIDEBAR bg matches the warm-ivory rail of the design system; right
 * border separates it from the middle work column.
 *
 * Each row is a custom QFrame (not QPushButton) — avoids the qfluentwidgets
 * PushButton icon-text collision bug for narrow CJK labels. Selected
 * state is driven by a [selected="true"] dynamic property the row
 * toggles via unpolish/polish on flip. */
QFrame#workspaceSidebar {
    background-color: $SIDEBAR;
    border-right: 1px solid $BORDER;
}
QFrame#workspaceSidebarRow {
    background-color: transparent;
    border-radius: ${RADIUS}px;
}
QFrame#workspaceSidebarRow:hover {
    background-color: $HOVER;
}
QFrame#workspaceSidebarRow[selected="true"] {
    background-color: $ACCENT_SOFT;
}
BodyLabel#workspaceSidebarRowLabel {
    color: $TEXT_2;
    font-size: 13px;
    background: transparent;
}
QFrame#workspaceSidebarRow:hover BodyLabel#workspaceSidebarRowLabel {
    color: $TEXT;
}
QFrame#workspaceSidebarRow[selected="true"] BodyLabel#workspaceSidebarRowLabel {
    color: $ACCENT;
    font-weight: 500;
}
CaptionLabel#workspaceSidebarRowBadge {
    background-color: $BADGE_GHOST_BG;
    color: $TEXT_2;
    border-radius: 8px;
    padding: 1px 7px;
    font-size: 11px;
    font-weight: 500;
}
QFrame#workspaceSidebarRow[selected="true"] CaptionLabel#workspaceSidebarRowBadge {
    background-color: $ACCENT;
    color: $ON_ACCENT;
}

/* Right-side context panel — stack of stage- and object-scoped pages
 * (catalog on 标注工作台 grid; future inspector on detail; future audit
 * queue on 审核修复). CONTENT bg so its hosted card surfaces read
 * naturally; left border separates it from the work area. */
QFrame#contextPanel {
    background-color: $CONTENT;
    border-left: 1px solid $BORDER;
}

/* Placeholder card shown inside an unfinished stage page. */
QFrame#stagePlaceholder {
    background-color: $SIDEBAR;
    border: 1px dashed $BORDER;
    border-radius: ${RADIUS_LG}px;
}
BodyLabel#stagePlaceholderText {
    color: $TEXT_3;
    font-size: 13px;
}

/* Selection action bar — only visible when the grid has a selection. Soft
 * accented background distinguishes it from the plain filter bar above so the
 * user can tell at a glance "these actions target the selection I just made".
 * Right side hosts destructive + reclassify + export actions; left side has
 * the count + a one-click clear. */
QFrame#selectionActionBar {
    background-color: $ACCENT_SOFT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}
BodyLabel#selectionCountLabel {
    color: $TEXT;
    font-weight: 500;
}

/* ============================================================
 * 4. Browser 左侧类别栏
 * ============================================================ */

QFrame#categorySidebar {
    background-color: $SIDEBAR;
    border-right: 1px solid $BORDER;
}

QLabel#sectionHeader,
CaptionLabel#sectionHeader {
    color: $TEXT_2;
    border-bottom: 1px solid $BORDER;
    padding: ${GAP_XS}px 0 ${GAP}px 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

QListWidget#categoryTree {
    background-color: transparent;
    border: none;
    padding: 4px;
    outline: 0;
}
QListWidget#categoryTree::item {
    padding: 0;
    margin: 0;
    color: $TEXT;
}
QListWidget#categoryTree::item:hover {
    background-color: $HOVER;
}
/* selection painted by delegate */
QListWidget#categoryTree::item:selected {
    background-color: transparent;
    color: $TEXT;
}

/* ============================================================
 * 4d. Catalog panel — hosted as a page in the right ContextPanel
 * ============================================================ */

QFrame#catalogPanel {
    background-color: $CONTENT;
}
BodyLabel#catalogTitle {
    color: $TEXT;
    font-family: "Georgia", "Songti SC", "Noto Serif SC", serif;
    font-size: 16px;
    font-weight: 500;
}
CaptionLabel#catalogSubtitle {
    color: $TEXT_3;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}
CaptionLabel#catalogCocoHint {
    color: $WARNING;
    font-size: 11px;
    padding-top: 4px;
}
QPushButton#catalogTab {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: ${RADIUS}px;
    padding: 3px 10px;
    color: $TEXT_2;
    font-size: 11px;
}
QPushButton#catalogTab:hover {
    color: $TEXT;
}
QPushButton#catalogTab:checked {
    background-color: $HOVER_STRONG;
    color: $TEXT;
    font-weight: 500;
}

/* ============================================================
 * 4c. Distribution chart card (nested inside Catalog panel)
 * ============================================================ */

QFrame#distributionChart {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
    margin: ${GAP_LG}px ${GAP}px ${GAP}px ${GAP}px;
}
CaptionLabel#distributionHead {
    color: $TEXT_3;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}
CaptionLabel#distributionRatio {
    color: $TEXT_2;
    font-size: 11px;
    font-weight: 500;
}
CaptionLabel#distributionRatio[warn="true"] {
    color: $WARNING;
}
CaptionLabel#distributionFoot {
    color: $TEXT_3;
    font-size: 10px;
}
BodyLabel#distributionCaption {
    color: $TEXT_2;
    font-size: 11px;
}

/* ============================================================
 * 4b. Dataset bar (Claude-web redesign — serif title + stat strip)
 * ============================================================ */

QFrame#datasetBar {
    background-color: $SIDEBAR;
    border-bottom: 1px solid $BORDER;
}
QLabel#datasetName {
    color: $TEXT;
    font-family: "Georgia", "Songti SC", "Noto Serif SC", serif;
    font-size: 17px;
    font-weight: 500;
}
QLabel#datasetPath {
    color: $TEXT_3;
    font-size: 11px;
}
QLabel#datasetFmt {
    color: $ACCENT;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 1px 6px;
    border: 1px solid $ACCENT;
    border-radius: 3px;
}
QLabel#datasetLoading {
    color: $ACCENT;
    font-size: 11px;
    font-style: italic;
    padding: 0 ${GAP_XS}px;
}
QLabel#statKey {
    color: $TEXT_3;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}
QLabel#statValue {
    color: $TEXT;
    font-size: 16px;
    font-weight: 600;
}
QLabel#statValueWarn {
    color: $WARNING;
    font-size: 16px;
    font-weight: 600;
}
QWidget#statCell {
    border-left: 1px solid $BORDER;
}
QFrame#statStrip > QWidget#statCell:first-child {
    border-left: none;
}

/* ============================================================
 * 5. Detail 视图
 * ============================================================ */

QFrame#detailTopBar {
    background-color: $CONTENT;
    border-bottom: 1px solid $BORDER;
}

/* Bottom-corner viewer HUD — floating zoom controls + cursor coords +
 * pixel readout. An opaque rounded panel so it stays legible over any
 * image. Lives on the QGraphicsView viewport, out of the top ribbon. */
QFrame#viewerHud {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: 6px;
}
CaptionLabel#viewerHudInfo {
    color: $TEXT_2;
    padding: 4px 8px;
}
QLabel#viewerHudSwatch {
    border: 1px solid $BORDER;
    border-radius: 2px;
}
QFrame#viewerHudSep {
    color: $BORDER;
    max-width: 1px;
}

/* Image inspector — hosted inside the right ContextPanel as
 * ContextPage.INSPECTOR (P1.6).  Bg/border come from the panel
 * itself; the inner frame stays transparent so its content reads as
 * part of the panel's surface, not as a card-on-card. */
QFrame#imageInspector {
    background-color: transparent;
}
QFrame#inspectorSummaryCard {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}
StrongBodyLabel#inspectorSummaryTitle {
    color: $TEXT;
    font-size: 13px;
}
CaptionLabel#inspectorSummaryLine {
    color: $TEXT_2;
    font-size: 12px;
}
CaptionLabel#inspectorSummaryStatus {
    color: $ACCENT;
    background-color: $ACCENT_SOFT;
    border-radius: ${RADIUS_SM}px;
    padding: 3px 8px;
    font-size: 11px;
}

/* 大模型标注 (VLM) pane empty state — shown when the project hasn't
 * enabled any of caption / conversations / grounding yet. */
StrongBodyLabel#vlmEmptyTitle {
    color: $TEXT;
    font-size: 14px;
}
BodyLabel#vlmEmptyBody {
    color: $TEXT_3;
}
CaptionLabel#vlmPartialHint {
    color: $TEXT_3;
    background-color: $SURFACE_DIM;
    border-radius: ${RADIUS}px;
    padding: 6px 10px;
}
QScrollArea#vlmScroll {
    background-color: transparent;
}
QScrollArea#vlmScroll > QWidget {
    background-color: transparent;
}
QFrame#vlmOverviewCard {
    background-color: $ACCENT_SOFT;
    border: 1px solid $ACCENT;
    border-radius: ${RADIUS}px;
}
StrongBodyLabel#vlmOverviewTitle,
CaptionLabel#vlmOverviewTitle {
    color: $TEXT;
    font-size: 12px;
    font-weight: 600;
}
BodyLabel#vlmOverviewBody {
    color: $TEXT_2;
    font-size: 12px;
}
CaptionLabel#vlmOverviewChip {
    color: $ACCENT;
    background-color: $CONTENT;
    border-radius: ${RADIUS_SM}px;
    padding: 3px 8px;
    font-size: 11px;
}
BodyLabel#annotationModeHint,
CaptionLabel#annotationModeHint {
    color: $TEXT_3;
    background-color: $SURFACE_DIM;
    border-radius: ${RADIUS}px;
    padding: 4px 8px;
    font-size: 11px;
}
QFrame#annotationModeCard {
    background-color: $ACCENT_SOFT;
    border: 1px solid $ACCENT;
    border-radius: ${RADIUS}px;
}
BodyLabel#annotationModeTitle {
    color: $TEXT;
    font-size: 13px;
    font-weight: 600;
}
CaptionLabel#annotationModeChip {
    color: $ACCENT;
    background-color: $CONTENT;
    border-radius: ${RADIUS_SM}px;
    padding: 3px 8px;
    font-size: 11px;
}
SegmentedWidget#vlmFormatTabs {
    background-color: transparent;
}
QStackedWidget#vlmFormatStack {
    background-color: transparent;
}

/* Grounding hint — when supports_grounding is on but the current image
 * has no shapes yet. Tells the user to create shapes in the Annotate
 * tab first. Lives in VlmPane's grounding section. */
CaptionLabel#regionTextHint {
    color: $TEXT_3;
    background-color: $SURFACE_DIM;
    border-radius: ${RADIUS}px;
    padding: 6px 10px;
}

QListWidget#shapeList {
    background-color: transparent;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
    outline: 0;
}
QListWidget#shapeList::item {
    padding: 6px 10px;
    color: $TEXT;
}
QListWidget#shapeList::item:hover {
    background-color: $HOVER_STRONG;
}
PlainTextEdit#captionEdit {
    background-color: transparent;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
    color: $TEXT;
    font-size: 13px;
    padding: 8px 10px;
}
PlainTextEdit#captionEdit:focus {
    border: 1px solid $ACCENT;
}
/* Conversation editor */
QScrollArea#convScroll {
    background-color: transparent;
    border: none;
}
QFrame#convTurnFrame {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}
CaptionLabel#convRole {
    color: $ACCENT;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}
PlainTextEdit#convTurnText {
    background-color: transparent;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
    color: $TEXT;
    font-size: 13px;
    padding: 6px 8px;
}
PlainTextEdit#convTurnText:focus {
    border: 1px solid $ACCENT;
}
/* Region text editor (per-shape grounding text) */
PlainTextEdit#regionTextEdit {
    background-color: transparent;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
    color: $TEXT;
    font-size: 13px;
    padding: 8px 10px;
}
PlainTextEdit#regionTextEdit:focus {
    border: 1px solid $ACCENT;
}

/* ============================================================
 * 5b. Batch list panel — body of the 收件箱 stage
 * ============================================================ */

QFrame#batchListPanel {
    background-color: $SIDEBAR;
}
BodyLabel#batchPanelTitle {
    color: $TEXT;
    font-family: "Georgia", "Songti SC", "Noto Serif SC", serif;
    font-size: 16px;
    font-weight: 500;
}
CaptionLabel#batchPanelSubtitle {
    color: $TEXT_3;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
}
QFrame#dropZone {
    background-color: $CONTENT;
    border-radius: ${RADIUS_LG}px;
}
QFrame#batchCard {
    background-color: $HOVER;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}
QFrame#batchCard:hover {
    background-color: $HOVER_STRONG;
}
BodyLabel#batchName {
    color: $TEXT;
    font-weight: 600;
    font-size: 13px;
}

/* ============================================================
 * 6. 缩略图网格
 * ============================================================ */

QListWidget#thumbnailGrid {
    background-color: $SIDEBAR;  /* ivory canvas, cards float above it */
    border: none;
    padding: 16px;
}
QListWidget#thumbnailGrid::item {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
}
QListWidget#thumbnailGrid::item:selected {
    background: transparent;
}

QFrame#thumbCard {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
QFrame#thumbCard:hover {
    border: 1px solid $HOVER_STRONG;
}
QFrame#thumbCard[selected="true"] {
    border: 2px solid $ACCENT;
}

QLabel#thumbImage {
    background-color: $SURFACE_DIM;
    color: $TEXT_3;
}

QWidget#thumbMeta {
    background-color: $CONTENT;
    border-top: 1px solid $BORDER;
}

QLabel#thumbBadge {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: 10px;
    padding: 0 8px;
    color: $TEXT_2;
}
QLabel#thumbBadge[state="labeled"] {
    color: $SUCCESS;
}
QLabel#thumbBadge[state="unlabeled"] {
    color: $WARNING;
}

/* ============================================================
 * 7. 欢迎页
 * ============================================================ */

QWidget#welcomeView {
    background-color: $CONTENT;
}

QLabel#welcomeTitle {
    color: $ACCENT;
}

QListWidget#projectList {
    background-color: $CONTENT;
    border: none;
    padding: 8px;
    outline: 0;
}
QListWidget#projectList::item {
    border: none;
    background: transparent;
    padding: 0;
    margin: 2px 0;
}

/* ============================================================
 * 8. 导出格式卡片
 * ============================================================ */

QFrame#formatCard {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
QFrame#formatCard:hover {
    background-color: $HOVER;
    border-color: $HOVER_STRONG;
}
QFrame#formatCard[selected="true"] {
    background-color: $ACCENT_SOFT;
    border: 2px solid $ACCENT;
}
QLabel#formatCardName[selected="true"] {
    color: $ACCENT;
}

/* ============================================================
 * 9. 预览面板
 * ============================================================ */

QFrame#previewSlot {
    background-color: $SURFACE_DIM;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}

/* ============================================================
 * 10. 占位视图
 * ============================================================ */

QLabel#placeholderStatus {
    color: $TEXT_2;
}

/* ============================================================
 * 11. 就绪检查条
 * ============================================================ */

QLabel#readinessOk,
QLabel#readinessGap {
    padding: 6px 14px;
    min-height: 20px;
    border-radius: 12px;
    background: $SURFACE_DIM;
}
QLabel#readinessOk {
    color: $SUCCESS;
}
QLabel#readinessGap {
    color: $WARNING;
    font-weight: 600;
}

/* ============================================================
 * 11b. Settings popup (floating Tweaks panel per design)
 * ============================================================ */

QFrame#settingsPopup {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
/* Settings popup — Claude-style menu list. */
BodyLabel#tweakHead {
    color: $TEXT_3;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding-left: 4px;
}
QLabel#tweakClose {
    color: $TEXT_3;
    font-size: 11px;
    border-radius: 4px;
}
QLabel#tweakClose:hover {
    color: $TEXT;
    background-color: $HOVER;
}
QFrame#tweakDivider {
    background-color: $BORDER;
    margin: 4px 8px;
}
QFrame#tweakRow {
    background-color: transparent;
    border-radius: ${RADIUS}px;
}
QFrame#tweakRow:hover {
    background-color: $HOVER;
}
QLabel#tweakIcon {
    color: $TEXT_2;
    background-color: transparent;
}
BodyLabel#tweakKey {
    color: $TEXT;
    font-size: 13px;
    background-color: transparent;
}
/* Inline segmented buttons — active state gets soft tan bg (design's
 * --bg-active ≈ rgba(60,40,20,0.07)). */
QPushButton#tweakSeg {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: ${RADIUS}px;
    padding: 3px 9px;
    color: $TEXT_3;
    font-size: 11px;
    min-width: 22px;
}
QPushButton#tweakSeg:hover {
    color: $TEXT;
}
QPushButton#tweakSeg:checked {
    background-color: $HOVER_STRONG;
    color: $TEXT;
}
/* ============================================================
 * 12. 节点编辑器工具箱 / 缩放按钮
 * ============================================================ */

QFrame#toolboxPanel {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
QFrame#toolboxItem:hover {
    background-color: $HOVER;
    border-radius: ${RADIUS}px;
}
QLabel#toolboxSection {
    color: $TEXT_3;
    padding: 4px 8px 2px 8px;
    font-weight: bold;
}
QLabel#toolboxTitle {
    font-weight: bold;
    color: $TEXT_2;
}
QFrame#zoomOverlay {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}

/* 标题栏方案名输入框 */
LineEdit#taskNameEdit {
    border: none;
    background: transparent;
    color: $TEXT;
    font-weight: bold;
    padding: 2px 4px;
}
LineEdit#taskNameEdit:focus {
    border: 1px solid $BORDER;
    border-radius: 4px;
    background: $CONTENT;
}

/* 节点检查器面板 */
QFrame#nodeInspector {
    background-color: $SIDEBAR;
    border-left: 1px solid $BORDER;
}
QFrame#inspectorHeader {
    border-bottom: 1px solid $BORDER;
}
QLabel#inspectorDesc {
    color: $TEXT_2;
}
QLabel#inspectorHint {
    color: $TEXT_3;
    font-size: 11px;
    padding: 2px 0;
}
QLabel#inspectorSectionTitle {
    color: $TEXT_3;
    font-weight: bold;
    padding: 4px 0 2px 0;
}
QFrame#inspectorSep {
    background-color: $BORDER;
}
QLabel#inspectorPortInfo {
    color: $ACCENT;
    padding: 2px 0;
}
QTreeWidget#inspectorDirTree {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
    padding: 4px;
    font-size: 12px;
}
QTreeWidget#inspectorDirTree::item {
    padding: 2px 0;
}

/* ============================================================
 * 训练版本 (Training Version hub)
 * ============================================================ */

/* Section cards */
QFrame#tvSection {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
StrongBodyLabel#tvSectionNumber {
    color: $ACCENT;
    font-size: 14px;
}
StrongBodyLabel#tvSectionTitle {
    color: $TEXT;
    font-size: 14px;
}

/* Stats banner */
QFrame#tvStatsBanner {
    background-color: $CONTENT;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS_LG}px;
}
StrongBodyLabel#tvProjectTitle {
    color: $TEXT;
    font-size: 14px;
}
CaptionLabel#tvStatsLabel {
    color: $TEXT_2;
    font-size: 12px;
}

/* Choice chips (exclusive select — scope / format) */
QFrame#tvChoiceChip {
    background-color: $SURFACE_DIM;
    border: 1px solid transparent;
    border-radius: ${RADIUS}px;
}
QFrame#tvChoiceChip:hover {
    border-color: $HOVER_STRONG;
}
QFrame#tvChoiceChip[selected="true"] {
    background-color: $ACCENT_SOFT;
    border-color: $ACCENT;
}
BodyLabel#tvChoiceChipLabel {
    color: $TEXT_2;
    font-size: 13px;
}
QFrame#tvChoiceChip[selected="true"] > BodyLabel#tvChoiceChipLabel {
    color: $ACCENT;
}

/* Split summary */
BodyLabel#tvSplitSummary {
    color: $TEXT;
    font-size: 13px;
}
CaptionLabel#tvSplitLabel {
    color: $TEXT_3;
    font-size: 12px;
}
CaptionLabel#tvFormatGroupLabel {
    color: $TEXT_3;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    margin-top: 4px;
}

/* Hint labels */
CaptionLabel#tvHintLabel {
    color: $TEXT_3;
    font-size: 11px;
}

/* Generated training versions */
QFrame#tvVersionRow {
    background-color: $SURFACE_DIM;
    border: 1px solid $BORDER;
    border-radius: ${RADIUS}px;
}
StrongBodyLabel#tvVersionName {
    color: $TEXT;
    font-size: 13px;
}
CaptionLabel#tvVersionMeta {
    color: $TEXT_3;
    font-size: 11px;
}

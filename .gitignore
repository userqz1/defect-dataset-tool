.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# App runtime/cache
~/.dataforge/
*.sqlite
*.db

# Local config overrides
config/local_*.yaml

# Logs
*.log

# Claude Code local settings
.claude/
.codex/
.run_logs/

# Augmentation / transform / convert test artifacts dropped in CWD
/images/
/labels/
